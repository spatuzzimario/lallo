# Copia questo file in .env.local (già in .gitignore, non committarlo mai) e riempi i
# valori reali dal dashboard Supabase (Settings → API) del progetto:
# https://zrzrmarrhiityuoszdze.supabase.co
#
# La EXPO_PUBLIC_SUPABASE_ANON_KEY è la chiave "anon public" — è sicura da esporre nel
# bundle client-side SOLO se la RLS (Row Level Security) è attiva su ogni tabella, come
# da supabase/schema.sql. Non usare mai la service_role key qui.

EXPO_PUBLIC_SUPABASE_URL=https://zrzrmarrhiityuoszdze.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat (paywall — abbonamenti reali, brief §7). Le due chiavi "Public app-specific
# API key" da RevenueCat → Project → API keys, una per piattaforma — non sono segrete
# (sono pensate per stare nel bundle client-side, a differenza delle secret key).
# Checklist completa di setup: vedi PAYWALL_SETUP.md alla radice del repo.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
