{
  "expo": {
    "name": "Lallo",
    "slug": "lallo",
    "version": "0.1.0",
    "scheme": "lallo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF6EE",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lallo.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lallo.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Lallo usa il microfono per registrare la voce del bambino negli esercizi di pronuncia (Registratore, Parla con Lallo), solo dopo il consenso del genitore."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Lallo usa la fotocamera per l'Album, dove il bambino fotografa oggetti reali che corrispondono alle parole che sta imparando, solo dopo il consenso del genitore. Le foto restano solo su questo dispositivo."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "1c0c18ea-f37e-45b8-9b32-01620ddaf6a5"
      }
    },
    "owner": "mr.vertigo"
  }
}
